const $ = id => document.getElementById(id);
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const metricInfo = {
 snowfall_in:{label:'Snowfall',unit:'in',format:v=>v.toFixed(2)+' in'},
 avg_temp_f:{label:'Average temperature',unit:'°F',format:v=>v.toFixed(1)+'°F'},
 max_snow_depth_ft:{label:'Maximum snow depth',unit:'ft',format:v=>v.toFixed(3)+' ft'},
 freezing_hours:{label:'Hours at or below 32°F',unit:'hours',format:v=>v.toFixed(0)+' hr'}
};
let activePoints=[];
function filtered(){const m=$('month').value;return weatherData.filter(d=>m==='all'||d.month===Number(m));}
function setupCanvas(canvas){
 const rect=canvas.getBoundingClientRect(), dpr=window.devicePixelRatio||1;
 canvas.width=Math.max(1,Math.round(rect.width*dpr));canvas.height=Math.max(1,Math.round(rect.height*dpr));
 const ctx=canvas.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);
 return {ctx,w:rect.width,h:rect.height};
}
function drawDaily(rows,metric,threshold){
 const c=$('dailyChart'),{ctx,w,h}=setupCanvas(c),L=48,R=14,T=16,B=38;
 ctx.clearRect(0,0,w,h);const vals=rows.map(d=>d[metric]);let min=Math.min(0,...vals),max=Math.max(1,...vals);
 if(min===max)max=min+1;const pad=(max-min)*.10;min-=pad;max+=pad;
 const x=i=>L+(w-L-R)*(rows.length<=1?0.5:i/(rows.length-1));
 const y=v=>T+(h-T-B)*(1-(v-min)/(max-min));
 ctx.font='11px system-ui';ctx.textAlign='right';ctx.textBaseline='middle';ctx.strokeStyle='#e5edf2';ctx.fillStyle='#6a7d8d';ctx.lineWidth=1;
 for(let j=0;j<=4;j++){const v=min+(max-min)*j/4,yy=y(v);ctx.beginPath();ctx.moveTo(L,yy);ctx.lineTo(w-R,yy);ctx.stroke();ctx.fillText(v.toFixed(metric==='freezing_hours'?0:2),L-8,yy);}
 ctx.strokeStyle='#176b87';ctx.lineWidth=2;ctx.beginPath();
 rows.forEach((d,i)=>{if(i===0)ctx.moveTo(x(i),y(d[metric]));else ctx.lineTo(x(i),y(d[metric]));});ctx.stroke();
 activePoints=[];
 rows.forEach((d,i)=>{const flagged=d.snowfall_in>=threshold;const px=x(i),py=y(d[metric]);if(rows.length<=120||i%Math.ceil(rows.length/100)===0||flagged){ctx.beginPath();ctx.arc(px,py,flagged?4:2.5,0,Math.PI*2);ctx.fillStyle=flagged?'#d97736':'#176b87';ctx.fill();}activePoints.push({x:px,y:py,label:d.date,value:metricInfo[metric].format(d[metric]),extra:'Snowfall: '+d.snowfall_in.toFixed(3)+' in'});});
 ctx.fillStyle='#6a7d8d';ctx.textAlign='center';ctx.textBaseline='alphabetic';const step=Math.max(1,Math.ceil(rows.length/7));
 for(let i=0;i<rows.length;i+=step)ctx.fillText(rows[i].date.slice(5),x(i),h-13);
 if(rows.length>1&&(rows.length-1)%step!==0)ctx.fillText(rows[rows.length-1].date.slice(5),x(rows.length-1),h-13);
}
function drawMonthly(){
 const c=$('monthlyChart'),{ctx,w,h}=setupCanvas(c),L=42,R=12,T=18,B=36;
 ctx.clearRect(0,0,w,h);const totals=months.map((_,i)=>weatherData.filter(d=>d.month===i+1).reduce((s,d)=>s+d.snowfall_in,0));
 const max=Math.max(1,...totals)*1.12,xstep=(w-L-R)/12,bw=xstep*.58,y=v=>T+(h-T-B)*(1-v/max);
 ctx.font='11px system-ui';ctx.textAlign='right';ctx.textBaseline='middle';ctx.fillStyle='#6a7d8d';ctx.strokeStyle='#e5edf2';
 for(let j=0;j<=4;j++){const v=max*j/4,yy=y(v);ctx.beginPath();ctx.moveTo(L,yy);ctx.lineTo(w-R,yy);ctx.stroke();ctx.fillText(v.toFixed(1),L-7,yy);}
 activeMonthly=[];
 totals.forEach((v,i)=>{const xx=L+i*xstep+(xstep-bw)/2,yy=y(v);ctx.fillStyle='#168a83';ctx.fillRect(xx,yy,bw,h-B-yy);activeMonthly.push({x:xx+bw/2,y:yy,label:months[i],value:v.toFixed(3)+' in snowfall'});});
 ctx.fillStyle='#6a7d8d';ctx.textAlign='center';ctx.textBaseline='alphabetic';months.forEach((m,i)=>ctx.fillText(m,L+i*xstep+xstep/2,h-13));
}
let activeMonthly=[];
function update(){
 const rows=filtered(),metric=$('metric').value,threshold=Number($('threshold').value);
 $('thresholdValue').textContent=threshold.toFixed(2)+' in';
 const sum=rows.reduce((s,d)=>s+d.snowfall_in,0),avg=rows.reduce((s,d)=>s+d.avg_temp_f,0)/rows.length,freeze=rows.reduce((s,d)=>s+d.freezing_hours,0),risk=rows.filter(d=>d.snowfall_in>=threshold).length;
 $('kpiSnow').textContent=sum.toFixed(2)+' in';$('kpiTemp').textContent=avg.toFixed(1)+'°F';$('kpiFreeze').textContent=freeze.toLocaleString()+' hr';$('kpiRisk').textContent=risk;
 $('dailyCaption').textContent=metricInfo[metric].label+' by day · '+rows.length+' observations';
 drawDaily(rows,metric,threshold);drawMonthly();
}
function tooltip(canvas,points){
 let tip=canvas.parentElement.querySelector('.charttip');
 if(!tip){tip=document.createElement('div');tip.className='charttip';tip.style.cssText='position:absolute;display:none;pointer-events:none;background:#102a43;color:white;padding:7px 9px;border-radius:7px;font:12px system-ui;z-index:3;box-shadow:0 3px 12px #0002;white-space:nowrap';canvas.parentElement.appendChild(tip);}
 function show(e){const rect=canvas.getBoundingClientRect(),px=e.clientX-rect.left,py=e.clientY-rect.top;let best=null,dist=Infinity;
 points().forEach(p=>{const d=Math.hypot(p.x-px,p.y-py);if(d<dist){dist=d;best=p;}});
 if(best&&dist<28){tip.innerHTML='<strong>'+best.label+'</strong><br>'+best.value+(best.extra?'<br>'+best.extra:'');tip.style.display='block';tip.style.left=Math.min(Math.max(4,best.x+10),rect.width-150)+'px';tip.style.top=Math.max(4,best.y-42)+'px';}else tip.style.display='none';
 }
 canvas.addEventListener('mousemove',show);canvas.addEventListener('mouseleave',()=>tip.style.display='none');
 canvas.addEventListener('touchstart',e=>{if(e.touches.length){const t=e.touches[0];show({clientX:t.clientX,clientY:t.clientY});}},{passive:true});
}
$('month').addEventListener('change',update);$('metric').addEventListener('change',update);$('threshold').addEventListener('input',update);
tooltip($('dailyChart'),()=>activePoints);tooltip($('monthlyChart'),()=>activeMonthly);
window.addEventListener('resize',update);update();
