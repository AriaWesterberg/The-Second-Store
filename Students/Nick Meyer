// Turn rows of {year, county, value, crop} (from CSV or API) into DATA.
function mergeRows(rows) {
  let added = 0; const touched = new Set();
  const byCropYear = {};
  for (const r of rows) {
    const v = parseValue(r.value);
    if (v == null || !r.county || !r.year) continue;
    let key = r.county.trim().toUpperCase();
    if (key.startsWith("OTHER")) key = OTHER_KEY;   // Quick Stats: "OTHER (COMBINED) COUNTIES"
    const crop = (r.crop || BUILT_IN_CROP).toUpperCase();
    const year = +r.year;
    (byCropYear[crop] ||= {});
    (byCropYear[crop][year] ||= []).push([key, v]);
  }
  for (const [crop, years] of Object.entries(byCropYear)) {
    DATA[crop] ||= {};
    for (const [year, list] of Object.entries(years)) {
      // A loaded year replaces that whole year for this crop (so nothing is double counted).
      for (const k of Object.keys(DATA[crop])) delete DATA[crop][k][year];
      for (const [key, v] of list) {
        DATA[crop][key] ||= {};
        DATA[crop][key][year] = (DATA[crop][key][year] || 0) + v;
        if (!DISPLAY_NAME[key]) DISPLAY_NAME[key] = titleCase(key);
        added++;
      }
      touched.add(`${titleCase(crop)} ${year}`);
    }
  }
  return { added, touched: [...touched].sort() };
