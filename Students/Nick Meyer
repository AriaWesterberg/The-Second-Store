// Quick Stats values look like "54,578,000"; "(D)" means withheld and "(Z)" means less than half a unit.
function parseValue(s) {
  if (s == null) return null;
  const t = String(s).replace(/,/g, "").trim();
  if (!t || t.startsWith("(")) return null;
  const n = Number(t);
  return Number.isFinite(n) ? n : null;
}
function titleCase(s) { return s.toLowerCase().replace(/\b([a-z])/g, m => m.toUpperCase()); }

/* ---------------- CSV loading (Quick Stats "Spreadsheet" export) ---------------- */
function parseCSV(text) {
  const rows = []; let row = [], field = "", q = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (q) {
      if (c === '"') { if (text[i+1] === '"') { field += '"'; i++; } else q = false; }
      else field += c;
    } else if (c === '"') q = true;
    else if (c === ",") { row.push(field); field = ""; }
    else if (c === "\n" || c === "\r") {
      if (c === "\r" && text[i+1] === "\n") i++;
      row.push(field); field = ""; if (row.some(x => x !== "")) rows.push(row); row = [];
    } else field += c;
  }
  row.push(field); if (row.some(x => x !== "")) rows.push(row);
  return rows;
}
function rowsFromQuickStatsCSV(text) {
  const table = parseCSV(text);
  const head = table[0].map(h => h.trim().toLowerCase());
  const col = name => head.indexOf(name);
  const iYear = col("year"), iCounty = col("county"), iValue = col("value");
  const iItem = col("data item"), iComm = col("commodity"), iState = col("state"), iPeriod = col("period");
  if (iYear < 0 || iCounty < 0 || iValue < 0) throw new Error("The CSV needs Year, County and Value columns.");
  const out = [];
  for (const r of table.slice(1)) {
    if (iState >= 0 && r[iState] && r[iState].toUpperCase() !== "MINNESOTA") continue;
    if (iPeriod >= 0 && r[iPeriod] && r[iPeriod].toUpperCase() !== "YEAR") continue; // skip forecasts by month
    const item = iItem >= 0 ? r[iItem] : "";
    if (item && !/PRODUCTION, MEASURED IN BU/i.test(item)) continue;   // keep production in bushels only
    const crop = item ? item.split(" - ")[0] : (iComm >= 0 ? r[iComm] : BUILT_IN_CROP);
    out.push({ year: r[iYear], county: r[iCounty], value: r[iValue], crop });
  }
  return out;
}

/* ---------------- Live API (optional; browser security may block it) ---------------- */
async function fetchFromAPI(key) {
  const url = "https://quickstats.nass.usda.gov/api/api_GET/?" + new URLSearchParams({
    key, source_desc: "SURVEY", sector_desc: "CROPS", commodity_desc: "CORN",
    statisticcat_desc: "PRODUCTION", unit_desc: "BU", agg_level_desc: "COUNTY",
    state_alpha: "MN", year__GE: "2015", format: "JSON"
  });
  const res = await fetch(url);
  if (!res.ok) throw new Error("Quick Stats answered " + res.status);
  const json = await res.json();
  return (json.data || [])
    .filter(d => (d.reference_period_desc || "YEAR") === "YEAR")
    .map(d => ({ year: d.year, county: d.county_name, value: d.Value, crop: (d.short_desc || "").split(" - ")[0] }));
}

/* ==========================================================================
   CALCULATIONS
   ========================================================================== */
const $ = id => document.getElementById(id);
const fmt = n => n == null ? "–" : Math.round(n).toLocaleString("en-US");
const fmtM = n => (n / 1e6).toLocaleString("en-US", { maximumFractionDigits: n >= 1e8 ? 0 : 1 }) + "M";

function yearsFor(crop) {
  const ys = new Set();
  for (const c of Object.values(DATA[crop] || {})) for (const y of Object.keys(c)) ys.add(+y);
  return [...ys].sort((a, b) => a - b);
}
function stateTotal(crop, year) {   // every row incl. "Other (combined)" = state total
  let s = 0; for (const c of Object.values(DATA[crop])) s += c[year] || 0; return s;
}

// Rank counties for the chosen crop and year(s).
function computeRanking(crop, years) {
  const totals = Object.fromEntries(years.map(y => [y, stateTotal(crop, y)]));
  const rows = [];
  for (const [key, byYear] of Object.entries(DATA[crop])) {
    if (key === OTHER_KEY) continue;
    const have = years.filter(y => byYear[y] != null);
    if (!have.length) continue;
    const avg = have.reduce((s, y) => s + byYear[y], 0) / have.length;
    const stateAvg = have.reduce((s, y) => s + totals[y], 0) / have.length;
    rows.push({ key, name: DISPLAY_NAME[key] || titleCase(key), district: DISTRICT_OF[key] || "–",
                avg, share: avg / stateAvg, partial: have.length < years.length, yearsUsed: have });
  }
  rows.sort((a, b) => b.share - a.share);
  rows.forEach((r, i) => r.rank = i + 1);
  return rows;
}

function planning(share) {
  const total = +$("stateTotal").value || 0;
  const haul = Math.min(100, Math.max(0, +$("haulPct").value || 0)) / 100;
  const perTruck = Math.max(1, +$("buPerTruck").value || 1000);
  const est = share * total;
  return { est, trucks: est * haul / perTruck, storage: est * haul };
}

/* ==========================================================================
   CONTROLS
   ========================================================================== */
function fillSelect(sel, options, keep) {
  const prev = keep ? sel.value : null;
  sel.innerHTML = options.map(([v, t]) => `<option value="${v}">${t}</option>`).join("");
  if (prev && options.some(([v]) => v === prev)) sel.value = prev;
}
function refreshControls() {
  fillSelect($("cropSel"), Object.keys(DATA).map(c => [c, titleCase(c)]), true);
  const ys = yearsFor($("cropSel").value);
  fillSelect($("yearSel"),
    [["all", `Average of ${ys.join(", ")}`], ...ys.slice().reverse().map(y => [String(y), String(y)])], true);
  const counties = Object.keys(DATA[$("cropSel").value]).filter(k => k !== OTHER_KEY)
    .map(k => [k, DISPLAY_NAME[k] || titleCase(k)]).sort((a, b) => a[1].localeCompare(b[1]));
  fillSelect($("countySel"), [["all", "All counties (ranking)"], ...counties], true);
}

/* ==========================================================================
   RENDER
   ========================================================================== */
let currentRows = [];
function render() {
  const crop = $("cropSel").value;
  const allYears = yearsFor(crop);
  const yv = $("yearSel").value;
  const years = yv === "all" ? allYears : [+yv];
  const county = $("countySel").value;
  const topN = +$("topN").value;
  $("topNLabel").textContent = topN;

  const rows = computeRanking(crop, years);
  currentRows = rows;
  const basis = yv === "all" ? `avg of ${years.join(", ")}` : yv;
  $("thBasis").textContent = `Production, ${basis} (bu)`;

  // Headline tiles
  const top3 = rows.slice(0, 3), top10 = rows.slice(0, 10);
  const top10share = top10.reduce((s, r) => s + r.share, 0);
  const t10 = planning(top10share);
  $("answer").innerHTML = `
    <div class="tile"><div class="label">Send the most to</div>
      <div class="big">${top3.map(r => r.name).join(", ")}</div>
      <div class="note">Largest shares of the state crop (${basis})</div></div>
    <div class="tile"><div class="label">Top 10 counties' share</div>
      <div class="big">${(top10share * 100).toFixed(0)}%</div>
      <div class="note">of Minnesota corn for grain</div></div>
    <div class="tile"><div class="label">Top 10: est. truckloads</div>
      <div class="big">${fmt(t10.trucks)}</div>
      <div class="note">at ${fmt(+$("buPerTruck").value)} bu per load</div></div>
    <div class="tile"><div class="label">Top 10: storage needed</div>
      <div class="big">${fmtM(t10.storage)} bu</div>
      <div class="note">from a ${fmtM(+$("stateTotal").value || 0)} bu state crop</div></div>`;

  if (county === "all") drawRanking(rows.slice(0, topN), basis);
  else drawCountyTrend(crop, county, allYears);

  // Table (always the full ranking; the selected county is highlighted)
  $("tbody").innerHTML = rows.map(r => {
    const p = planning(r.share);
    const hl = r.key === county ? ' style="background:var(--surface-0);font-weight:650"' : "";
    return `<tr${hl}><td>${r.rank}</td><td>${r.name}${r.partial ? ' <span class="flag">*</span>' : ""}</td>
      <td>${r.district}</td><td>${fmt(r.avg)}</td><td>${(r.share * 100).toFixed(2)}%</td>
      <td>${fmt(p.est)}</td><td>${fmt(p.trucks)}</td><td>${fmt(p.storage)}</td></tr>`;
  }).join("");
}

/* ---- Tooltip helpers ---- */
const tip = $("tip");
function showTip(e, html) { tip.innerHTML = html; tip.style.display = "block"; moveTip(e); }
function moveTip(e) {
  const pad = 14, w = tip.offsetWidth, h = tip.offsetHeight;
  let x = e.clientX + pad, y = e.clientY + pad;
  if (x + w > innerWidth - 8) x = e.clientX - w - pad;
  if (y + h > innerHeight - 8) y = e.clientY - h - pad;
  tip.style.left = x + "px"; tip.style.top = y + "px";
}
function hideTip() { tip.style.display = "none"; }
function svgEl(tag, attrs, parent) {
  const el = document.createElementNS("http://www.w3.org/2000/svg", tag);
  for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
  if (parent) parent.appendChild(el); return el;
}
function niceMax(v) {
  const p = Math.pow(10, Math.floor(Math.log10(v))); const m = v / p;
  const steps = [1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10];
  return steps.find(x => m <= x + 1e-9) * p;
}

/* ---- Chart 1: horizontal bars, top N counties ---- */
function drawRanking(rows, basis) {
  // Bar length = estimated 2026 bushels (county share x statewide number), so longer bar = higher rank.
  $("chartTitle").textContent = `Top ${rows.length} counties: estimated 2026 corn to move and store`;
  $("chartSub").textContent = `Bushels. County share of the state crop (${basis}) × the statewide number above. Hover for details; click a bar to see that county's history.`;
  rows = rows.map(r => ({ ...r, est: planning(r.share).est }));
  const W = 1040, rowH = 26, top = 26, left = 150, right = 90, bottom = 8;
  const H = top + rows.length * rowH + bottom;
  const max = niceMax(Math.max(1, ...rows.map(r => r.est)));
  const x = v => left + (v / max) * (W - left - right);
  const box = $("chart"); box.innerHTML = "";
  const svg = svgEl("svg", { viewBox: `0 0 ${W} ${H}`, role: "img",
    "aria-label": `Bar chart of top ${rows.length} Minnesota counties by estimated 2026 corn bushels` }, box);
  // Grid + axis labels (recessive)
  for (let i = 0; i <= 4; i++) {
    const v = max * i / 4, gx = x(v);
    svgEl("line", { x1: gx, x2: gx, y1: top - 6, y2: H - bottom, stroke: "var(--grid)", "stroke-width": 1 }, svg);
    const t = svgEl("text", { x: gx, y: 14, "text-anchor": "middle", "font-size": 12, fill: "var(--text-muted)" }, svg);
    t.textContent = v === 0 ? "0" : fmtM(v);
  }
  rows.forEach((r, i) => {
    const y = top + i * rowH, bh = 16, by = y + (rowH - bh) / 2;
    const name = svgEl("text", { x: left - 10, y: by + bh / 2 + 4, "text-anchor": "end", "font-size": 13, fill: "var(--text-primary)" }, svg);
    name.textContent = r.name + (r.partial ? " *" : "");
    // Bar: square at the baseline, 4px rounded at the data end
    const w = Math.max(2, x(r.est) - left), rr = Math.min(4, w);
    svgEl("path", { d: `M${left},${by} H${left + w - rr} Q${left + w},${by} ${left + w},${by + rr} V${by + bh - rr} Q${left + w},${by + bh} ${left + w - rr},${by + bh} H${left} Z`,
      fill: "var(--series-1)" }, svg);
    if (i < 5) { // direct-label only the leaders
      const v = svgEl("text", { x: left + w + 6, y: by + bh / 2 + 4, "font-size": 12, fill: "var(--text-secondary)" }, svg);
      v.textContent = fmtM(r.est);
    }
    // Hit target: the whole row, bigger than the bar
    const hit = svgEl("rect", { x: 0, y, width: W, height: rowH, fill: "transparent", style: "cursor:pointer" }, svg);
    const p = planning(r.share);
    const html = `<b>#${r.rank} ${r.name}</b> · ${r.district}<br>
      Production (${basis}): <b>${fmt(r.avg)}</b> bu<br>
      Share of state: <b>${(r.share * 100).toFixed(2)}%</b><br>
      2026 est.: ${fmt(p.est)} bu<br>Truckloads: ${fmt(p.trucks)} · Storage: ${fmtM(p.storage)} bu
      ${r.partial ? `<br><span class="flag">Published years: ${r.yearsUsed.join(", ")}</span>` : ""}`;
    hit.addEventListener("mouseenter", e => showTip(e, html));
    hit.addEventListener("mousemove", moveTip);
    hit.addEventListener("mouseleave", hideTip);
    hit.addEventListener("click", () => { $("countySel").value = r.key; hideTip(); render(); });
  });
}

/* ---- Chart 2: one county over the years ---- */
function drawCountyTrend(crop, key, years) {
  const name = DISPLAY_NAME[key] || titleCase(key);
