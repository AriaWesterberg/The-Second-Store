  const max = niceMax(Math.max(1, ...vals.filter(v => v != null)));
  const band = (W - left - right) / years.length, bw = Math.min(90, band * 0.55);
  const yS = v => top + (1 - v / max) * (H - top - bottom);
  const box = $("chart"); box.innerHTML = "";
  const svg = svgEl("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": `${name} County corn production by year` }, box);
  for (let i = 0; i <= 4; i++) {
    const v = max * i / 4, gy = yS(v);
    svgEl("line", { x1: left, x2: W - right, y1: gy, y2: gy, stroke: "var(--grid)", "stroke-width": 1 }, svg);
    const t = svgEl("text", { x: left - 8, y: gy + 4, "text-anchor": "end", "font-size": 12, fill: "var(--text-muted)" }, svg);
    t.textContent = v === 0 ? "0" : fmtM(v);
  }
  years.forEach((y, i) => {
    const cx = left + band * i + band / 2, v = vals[i];
    const lbl = svgEl("text", { x: cx, y: H - bottom + 20, "text-anchor": "middle", "font-size": 13, fill: "var(--text-secondary)" }, svg);
    lbl.textContent = y;
    let html;
    if (v == null) {
      const t = svgEl("text", { x: cx, y: yS(0) - 8, "text-anchor": "middle", "font-size": 12, fill: "var(--text-muted)" }, svg);
      t.textContent = "not published";
      html = `<b>${name}, ${y}</b><br>NASS withheld this county's number this year.`;
    } else {
      const bx = cx - bw / 2, by = yS(v), bh = yS(0) - by, rr = Math.min(4, bh);
      svgEl("path", { d: `M${bx},${yS(0)} V${by + rr} Q${bx},${by} ${bx + rr},${by} H${bx + bw - rr} Q${bx + bw},${by} ${bx + bw},${by + rr} V${yS(0)} Z`,
        fill: "var(--series-1)" }, svg);
